{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["DOM", "ES2020"],
    "jsx": "react",
    "moduleResolution": "node",
    "module": "ESNext",
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noImplicitAny": false,
    "baseUrl": ".",
    "paths": {
      "react": ["../web/node_modules/react"],
      "axios": ["../web/node_modules/axios"]
    }
  },
  "include": ["src/**/*", "App.tsx"]
}
