{
  "$schema": "https://schema.tauri.app/config/1",
  "build": {
    "beforeBuildCommand": "npm --prefix ../web run build",
    "beforeDevCommand": "npm --prefix ../web run dev",
    "devPath": "http://localhost:3000",
    "distDir": "../web/dist"
  },
  "package": {
    "productName": "EDU CLICK",
    "version": "4.0.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": {
        "all": false,
        "open": true
      },
      "dialog": {
        "all": true,
        "open": true,
        "save": true
      },
      "fs": {
        "all": true,
        "scope": ["$DOWNLOAD/*", "$DESKTOP/*"]
      },
      "notification": {
        "all": true
      },
      "http": {
        "all": true,
        "request": true,
        "scope": ["http://localhost:5000/*", "https://*"]
      },
      "window": {
        "all": true,
        "setFullscreen": true,
        "setTitle": true
      }
    },
    "bundle": {
      "active": true,
      "category": "Education",
      "copyright": "2026 EDU CLICK (Pvt) Ltd. All rights reserved.",
      "identifier": "lk.educlick.desktop",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.ico",
        "icons/icon.png"
      ],
      "targets": ["msi", "nsis"],
      "windows": {
        "certificateThumbprint": null,
        "digestAlgorithm": "sha256",
        "timestampUrl": ""
      }
    },
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "main",
        "title": "EDU CLICK – One Platform. Every Device. Every Student.",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "fileDropEnabled": true
      }
    ]
  }
}
